# cost-insight 环境变量样例 —— 复制为 .env 后按需填写
# 全部可选：不配置 LLM 也能跑（自动降级：意图路由规则兜底、报告文字模板生成，界面如实标注）

# ---- 主模型（报告撰文 / 归因生成 / 任务润色）----
# OpenAI 兼容协议，Kimi / DeepSeek / Qwen 均可
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 小模型（可选：Agent 意图分类专用，不配则回退主模型）----
# LLM_SMALL_BASE_URL=
# LLM_SMALL_API_KEY=
# LLM_SMALL_MODEL=

# ---- 高级覆盖（一般不用动）----
# COST_INSIGHT_DATA_DIR=     # 考题数据目录（Docker 内固定 /data-source）
# VECTOR_BACKEND=numpy       # numpy=开发精确余弦 / milvus_lite=Docker 生产
# RPA_BASE_URL=http://127.0.0.1:8090
# PLACEHOLDER_MAP_PATH=      # 换报告模板时的映射 YAML 路径
# REPORT_TEMPLATE=           # 报告模板 docx 路径
